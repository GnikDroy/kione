file(GLOB font_files "${FONT_DIR}/*.ttf")
list(SORT font_files)

set(body "// Generated by cmake/embed_fonts.cmake from src/core/fonts — do not edit.\n")
string(APPEND body "#include \"core/embedded_fonts.hpp\"\n\nnamespace k2::embedded_fonts {\n")
foreach(file IN LISTS font_files)
    get_filename_component(name "${file}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${name}" ident)
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
    string(APPEND body "\nconst unsigned char ${ident}[] = { ${bytes} };\n")
    string(APPEND body "const std::size_t ${ident}_size = sizeof(${ident});\n")
endforeach()
string(APPEND body "\n}\n")

file(WRITE "${OUTPUT}" "${body}")
