version: 0.0.1
name: main
main_scene: main
assets:
  Scene:
    main: file:///main.k2scene
  Image:
    autumn_: file:///textures/autumn_.png?filter=nearest
    coin_: file:///textures/coin_.png?filter=nearest
    foreground_: file:///textures/foreground_.png?filter=nearest
    sky_: file:///textures/sky_.png?filter=nearest
    spring_: file:///textures/spring_.png?filter=nearest
    staticObjects_: file:///textures/staticObjects_.png?filter=nearest
  TileSet:
    sky: file:///tilesets/sky.k2tileset
    foreground: file:///tilesets/foreground.k2tileset
    spring: file:///tilesets/spring.k2tileset
    autumn: file:///tilesets/autumn.k2tileset
    objects: file:///tilesets/objects.k2tileset
  Animation:
    coin: file:///animations/coin.k2anim
    water: file:///animations/water.k2anim
  Script:
    player: file:///scripts/player.lua
